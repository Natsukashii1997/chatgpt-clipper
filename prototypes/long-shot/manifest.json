{
  "manifest_version": 3,
  "name": "chatgpt-clipper 原型① 长图",
  "version": "0.0.1",
  "description": "一次性原型：比较三种长图截取方案，验完即弃。",
  "permissions": ["debugger", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "bg.js" },
  "content_scripts": [
    { "matches": ["https://chatgpt.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
